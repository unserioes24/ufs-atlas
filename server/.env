# Vorgaben für die Anwendung. Echte Werte kommen aus der Umgebung des
# Containers (docker-compose bzw. CI-Variablen) und gehören nicht ins Repo.

APP_ENV=prod
APP_DEBUG=0
APP_SECRET=change-me-in-the-environment

# MariaDB-Dienst aus dem Compose-Stack
DATABASE_URL="mysql://fish:fish@db:3306/fish?serverVersion=11.4.0-MariaDB&charset=utf8mb4"

# SMTP-Zugang; Beispiel: smtp://benutzer:passwort@mail.example.org:587
MAILER_DSN=null://null
MAILER_FROM=fish@unserioes24.de
MAILER_FROM_HEADER="UFS Atlas <fish@unserioes24.de>"

# Traefik terminiert TLS und setzt die X-Forwarded-Header
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
