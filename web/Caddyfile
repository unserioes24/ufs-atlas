# Interner Dateiserver für die statische Seite.
# TLS und Host-Routing übernimmt Traefik davor, Caddy hört deshalb im
# `web`-Netz nur auf Port 80.
:80 {
	root * /srv
	encode zstd gzip

	file_server

	handle_errors {
		@notfound expression `{err.status_code} == 404`
		handle @notfound {
			rewrite * /index.html
			file_server
		}
	}

	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Die Seite soll nicht in Suchmaschinen auftauchen.
		X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
	}

	# Aus dem Spiel extrahierte Medien ändern sich nur bei einer Neuextraktion.
	@media path /maps/* /fish/* /models/*
	@rest not path /maps/* /fish/* /models/*
	header @media Cache-Control "public, max-age=604800"
	header @rest Cache-Control "public, max-age=300"
}
