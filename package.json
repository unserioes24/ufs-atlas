{
  "name": "ufs-atlas",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Fan-Atlas für Ultimate Fishing Simulator 1: Reviere, Arten, Köder und Spielstand-Auswertung",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/unserioes24/ufs-atlas"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/sitemap.mjs && vite build",
    "build:offline": "vite build --config vite.config.offline.ts && node scripts/offline-html.mjs",
    "preview": "vite preview",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
