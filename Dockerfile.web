# One container: Apache with PHP serves both the guide and the API.
#
# The guide is built from TypeScript sources here and lands in server/public;
# Symfony only sees requests that do not hit a file there.

# ── Guide ────────────────────────────────────────────────────────────
FROM node:22-alpine AS web
WORKDIR /app
# Dependencies first: they change far less often than the sources.
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json vite.config.ts tailwind.config.js postcss.config.js index.html ./
COPY src ./src
COPY public ./public
RUN npm run build

# ── PHP dependencies ─────────────────────────────────────────────────
FROM composer:2 AS vendor
WORKDIR /app
COPY server/composer.json ./
# Without --ignore-platform-reqs: composer.json pins the platform to PHP 8.5
# and every Symfony package to 7.4 – otherwise Composer mixes 7.4 and 8.x.
RUN composer install --no-dev --no-scripts --prefer-dist --no-interaction

# ── Runtime ──────────────────────────────────────────────────────────
FROM php:8.5-apache

# OPcache is built into the PHP 8.5 images; docker-php-ext-install would fail
# on it, so it is only configured through conf.d.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends curl; \
    rm -rf /var/lib/apt/lists/*; \
    docker-php-ext-install pdo_mysql; \
    a2enmod rewrite headers; \
    printf 'opcache.enable=1\nopcache.validate_timestamps=0\nopcache.max_accelerated_files=20000\n' \
        > /usr/local/etc/php/conf.d/opcache.ini; \
    printf 'memory_limit=256M\nupload_max_filesize=16M\npost_max_size=16M\nexpose_php=Off\n' \
        > /usr/local/etc/php/conf.d/app.ini

ENV APACHE_DOCUMENT_ROOT=/var/www/html/public
RUN sed -ri 's!/var/www/html!${APACHE_DOCUMENT_ROOT}!g' \
        /etc/apache2/sites-available/*.conf /etc/apache2/apache2.conf

WORKDIR /var/www/html

# Symfony application
COPY server/ ./
COPY --from=vendor /app/vendor ./vendor

# The built guide
COPY --from=web /app/dist/ ./public/

COPY deploy/apache-app.conf /etc/apache2/conf-available/app.conf
COPY deploy/entrypoint.sh /usr/local/bin/entrypoint
RUN set -eux; \
    a2enconf app; \
    chmod +x /usr/local/bin/entrypoint; \
    mkdir -p var/cache var/log var/sessions; \
    chown -R www-data:www-data var

EXPOSE 80
ENTRYPOINT ["/usr/local/bin/entrypoint"]
CMD ["apache2-foreground"]
